{
  "version": "0.2",
  "description": "Layer-1 regex deny patterns for the Vaara plugin. Covers shell and web input, file mutation (Write, Edit, NotebookEdit), and the agent's meta-actions: subagent spawn (Agent, Task, Workflow), scheduling (CronCreate), remote execution (RemoteTrigger), cross-session messaging (SendMessage) and writes to the harness's own configuration. Rules with match_any fire on any call to the tool; unless_env names a variable that, set to 1, lifts the rule for a deliberate exception. Rules with any_field false only apply by tool name; their pattern reads a specific field and means nothing over arbitrary arguments.",
  "rules": [
    {
      "id": "ssrf_cloud_metadata_ipv4",
      "tools": [
        "Bash",
        "WebFetch"
      ],
      "fields": [
        "command",
        "url"
      ],
      "pattern": "169\\.254\\.169\\.254",
      "message": "AWS/GCP/Azure instance-metadata IP — common SSRF / credential exfiltration target."
    },
    {
      "id": "ssrf_gcp_metadata_host",
      "tools": [
        "Bash",
        "WebFetch"
      ],
      "fields": [
        "command",
        "url"
      ],
      "pattern": "metadata\\.google\\.internal",
      "message": "GCP metadata host — credential exfiltration target."
    },
    {
      "id": "ssrf_azure_imds_host",
      "tools": [
        "Bash",
        "WebFetch"
      ],
      "fields": [
        "command",
        "url"
      ],
      "pattern": "100\\.100\\.100\\.200|metadata\\.azure\\.com",
      "message": "Azure IMDS / metadata host — credential exfiltration target."
    },
    {
      "id": "etc_shadow_read",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "/etc/(shadow|gshadow|sudoers)\\b",
      "message": "Read of /etc/shadow or related privileged files."
    },
    {
      "id": "etc_passwd_exfil",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "(curl|wget|nc|netcat|scp)\\s[^|;&]*\\b/etc/passwd\\b",
      "message": "Exfiltration of /etc/passwd through a network tool."
    },
    {
      "id": "remote_pipe_to_shell",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\b(curl|wget|fetch)\\b[^|]+\\|\\s*(bash|sh|zsh|ksh|dash|fish)\\b",
      "message": "Piping remote content directly into a shell — unverified code execution."
    },
    {
      "id": "rm_rf_root",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\brm\\s+(-[rRf]+|--recursive|--force)[^|;]*\\s+/(\\s|$|;|&|\\|)",
      "message": "rm -rf / or equivalent — non-recoverable filesystem destruction."
    },
    {
      "id": "fork_bomb_classic",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
      "message": "Classic shell fork bomb."
    },
    {
      "id": "dd_to_block_device",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\bdd\\b[^|;]*\\bof=/dev/(sd[a-z]|nvme\\d+n\\d+|disk\\d+|mmcblk\\d+)",
      "message": "dd writing directly to a raw block device — disk destruction."
    },
    {
      "id": "history_purge",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "history\\s+-c|>\\s*~?/?\\.bash_history|\\bunset\\s+HISTFILE",
      "message": "Shell history purge — common post-compromise covering of tracks."
    },
    {
      "id": "ssh_authorized_keys_write",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "(>>?|tee)\\s+[^|;]*\\.ssh/authorized_keys",
      "message": "Write to ~/.ssh/authorized_keys — persistent SSH backdoor."
    },
    {
      "id": "reverse_shell_bash_tcp",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "bash\\s+-i\\s+>&?\\s+/dev/tcp/",
      "message": "bash reverse shell over /dev/tcp."
    },
    {
      "id": "base64_piped_exec",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\bbase64\\s+(--decode|-d|-D)\\b[^|]*\\|\\s*(bash|sh|python|python3|perl|ruby)\\b",
      "message": "Base64-decoded payload piped to an interpreter — common obfuscated execution."
    },
    {
      "id": "shell_rc_persistence",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
      "fields": [
        "file_path",
        "notebook_path"
      ],
      "pattern": "(^|/)\\.(bashrc|bash_profile|zshrc|zprofile|profile|zshenv)$",
      "message": "Write to a shell startup file - classic persistence: the payload re-runs on every new shell."
    },
    {
      "id": "git_hooks_write",
      "tools": [
        "Write",
        "Edit"
      ],
      "fields": [
        "file_path"
      ],
      "pattern": "\\.git/hooks/(pre-commit|post-commit|pre-push|post-checkout|post-merge|prepare-commit-msg)",
      "message": "Write to a git hook - executes on ordinary git commands and rides the repo to other machines."
    },
    {
      "id": "cron_persistence_write",
      "tools": [
        "Write",
        "Edit"
      ],
      "fields": [
        "file_path"
      ],
      "pattern": "(/etc/cron|/var/spool/cron|/etc/crontab)",
      "message": "Write to a cron location - schedules code to run unattended."
    },
    {
      "id": "launch_persistence_write",
      "tools": [
        "Write",
        "Edit"
      ],
      "fields": [
        "file_path"
      ],
      "pattern": "(Library/Launch(Agents|Daemons)/|/etc/systemd/system/|\\.config/systemd/user/)",
      "message": "Write to a launchd or systemd unit path - starts code at login or boot."
    },
    {
      "id": "written_remote_pipe_to_shell",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
      "fields": [
        "content",
        "new_string",
        "new_source"
      ],
      "pattern": "(curl|wget)[^\\n|]{0,200}\\|\\s*(sudo\\s+)?(ba)?sh",
      "message": "File content pipes a remote download straight into a shell - executes unreviewed remote code."
    },
    {
      "id": "written_reverse_shell",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
      "fields": [
        "content",
        "new_string",
        "new_source"
      ],
      "pattern": "(bash\\s+-i\\s*>&\\s*/dev/tcp/|nc\\s+(-[a-z]*e[a-z]*\\s+)|socket\\.socket\\([^)]*\\)[\\s\\S]{0,120}connect\\()",
      "message": "File content contains a reverse-shell pattern - hands an outside party an interactive session."
    },
    {
      "id": "ssh_authorized_keys_file_write",
      "tools": [
        "Write",
        "Edit"
      ],
      "fields": [
        "file_path"
      ],
      "pattern": "\\.ssh/(authorized_keys|authorized_keys2)$",
      "message": "Write to SSH authorized_keys - installs a login key for whoever holds the private half."
    },
    {
      "id": "system_credential_file_write",
      "tools": [
        "Write",
        "Edit"
      ],
      "fields": [
        "file_path"
      ],
      "pattern": "/etc/(shadow|gshadow|passwd|sudoers)(\\.d/[^/]*)?$",
      "message": "Write to a system credential or privilege file - changes who can log in or escalate."
    },
    {
      "id": "agent_spawn",
      "tools": [
        "Agent",
        "Task"
      ],
      "match_any": true,
      "unless_env": "VAARA_ALLOW_SPAWN",
      "message": "Subagent spawn. Operator policy is no subagents; set VAARA_ALLOW_SPAWN=1 for a named job."
    },
    {
      "id": "workflow_fanout",
      "tools": [
        "Workflow"
      ],
      "match_any": true,
      "unless_env": "VAARA_ALLOW_SPAWN",
      "message": "Workflow fan-out spawns many agents in one call; set VAARA_ALLOW_SPAWN=1 for a named job."
    },
    {
      "id": "remote_trigger_execute",
      "tools": [
        "RemoteTrigger"
      ],
      "fields": [
        "action"
      ],
      "pattern": "^(create|update|run|create_webhook_trigger)$",
      "unless_env": "VAARA_ALLOW_REMOTE",
      "message": "Creates or runs a cloud agent: remote execution and data egress. Set VAARA_ALLOW_REMOTE=1 to permit.",
      "any_field": false
    },
    {
      "id": "cron_durable_job",
      "tools": [
        "CronCreate"
      ],
      "fields": [
        "durable"
      ],
      "pattern": "^true$",
      "unless_env": "VAARA_ALLOW_SCHEDULE",
      "message": "A durable scheduled job survives the session. Set VAARA_ALLOW_SCHEDULE=1 to permit; session-only jobs pass.",
      "any_field": false
    },
    {
      "id": "cross_session_message",
      "tools": [
        "SendMessage"
      ],
      "fields": [
        "to"
      ],
      "pattern": "^(?!main$).+",
      "unless_env": "VAARA_ALLOW_XSESSION",
      "message": "Message to another agent or session leaves the governed session. Set VAARA_ALLOW_XSESSION=1 to permit.",
      "any_field": false
    },
    {
      "id": "shell_upload_egress",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\b(curl|wget)\\b(?=[^|\\n]*\\s(?:-d|--data(?:-\\w+)?|--upload-file|-T|-F|--form|--json)\\b)(?=[^|\\n]*https?://(?!localhost|127\\.|0\\.0\\.0\\.0|\\[::1\\]))",
      "message": "Outbound upload to a remote host from the shell."
    },
    {
      "id": "shell_copy_egress",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "\\b(scp|rsync|sftp)\\b[^|\\n]*\\s[^\\s@]+@[^\\s:]+:",
      "message": "Copy to a remote host from the shell."
    },
    {
      "id": "harness_config_write",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ],
      "fields": [
        "file_path",
        "notebook_path"
      ],
      "pattern": "(^|/)(\\.claude\\.json|\\.claude/(settings(\\.local)?\\.json|hooks/|skills/|agents/|scheduled_tasks\\.json)|\\.claude-plugin/|\\.mcp\\.json$)",
      "unless_env": "VAARA_ALLOW_HARNESS_EDIT",
      "message": "Writes the agent harness configuration (hooks, skills, settings, MCP). Set VAARA_ALLOW_HARNESS_EDIT=1 for a deliberate edit."
    },
    {
      "id": "harness_config_shell_write",
      "tools": [
        "Bash"
      ],
      "fields": [
        "command"
      ],
      "pattern": "(^|[\\s;&|])(sed\\s+-i|tee|cp|mv|rm|chmod|truncate|>+)[^|\\n]*(\\.claude\\.json|\\.claude/(settings(\\.local)?\\.json|hooks/|skills/|agents/|scheduled_tasks\\.json)|\\.claude-plugin/|\\.mcp\\.json)",
      "unless_env": "VAARA_ALLOW_HARNESS_EDIT",
      "message": "Rewrites the agent harness configuration from the shell. Set VAARA_ALLOW_HARNESS_EDIT=1 for a deliberate edit."
    }
  ]
}
